---
export interface Props {
  n: number;
  id: string;
  thumb: string;
  title: { fr: string; en: string };
  services: { fr: string; en: string };
}
const { n, id, thumb, title, services } = Astro.props;
const no = String(n).padStart(2, '0');
---

<a href={`/projects/${id}`} class="block" id={`p-${id}`}>
  <div class="block-head label">
    <span>(1.{n})</span>
    <b>
      <span class="lang-fr">{title.fr}</span>
      <span class="lang-en">{title.en}</span>
    </b>
    <span class="block-rule"></span>
    <span>↗</span>
  </div>
  <div class="shot">
    <img src={thumb} alt="" loading="lazy" />
  </div>
  <div class="block-foot">
    <span class="block-no">{no}</span>
    <p class="block-services">
      <span class="lang-fr">{services.fr}</span>
      <span class="lang-en">{services.en}</span>
    </p>
  </div>
</a>

<style>
  .block {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  /* The signal bar slides in along the left edge, as in the mark. */
  .block::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--gap) / 2 - 3px);
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--signal);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.4s var(--ease);
  }
  .block:hover::before, .block:focus-visible::before { transform: scaleY(1); }

  .block-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .block-rule { flex: 1; height: 1px; background: var(--line); }

  .block-foot {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .block-no {
    font: 500 clamp(40px, 5vw, 80px)/0.85 var(--font);
    letter-spacing: -0.05em;
    color: var(--ink);
  }
  .block-services { color: var(--muted); font-size: 15px; max-width: 28ch; }
</style>
