---
const isHome = Astro.url.pathname === '/';
---

<header class="bar">
  <a href="/" class="bar-mark" aria-label="Sewa Ganse — index">
    <svg viewBox="0 0 120 100" width="26" height="22" aria-hidden="true">
      <path d="M0 100V40A40 40 0 0 1 40 0H80V22H40A18 18 0 0 0 22 40V100Z" fill="currentColor" />
      <rect x="98" y="0" width="22" height="100" fill="var(--signal)" />
    </svg>
    <span class="label"><b>Sewa Ganse</b></span>
  </a>

  <span class="label bar-role">
    {isHome ? (
      <>
        <span class="lang-fr">(0.0) Développeur web &amp; mobile</span>
        <span class="lang-en">(0.0) Web &amp; mobile developer</span>
      </>
    ) : (
      <a href="/#index" class="bar-back">
        <span class="lang-fr">← Index</span>
        <span class="lang-en">← Index</span>
      </a>
    )}
  </span>

  <nav class="bar-nav label">
    <a href="mailto:sewaganse@gmail.com" class="bar-mail">sewaganse@gmail.com</a>
    <a href="https://www.linkedin.com/in/sewa-ganse" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href="https://github.com/sha-riyat" target="_blank" rel="noopener noreferrer">GitHub</a>
    <button id="lang-toggle" class="bar-lang" aria-label="Toggle language">
      <span class="lang-fr"><b>FR</b> / EN</span>
      <span class="lang-en">FR / <b>EN</b></span>
    </button>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: center;
    height: 56px;
    padding: 0 var(--m);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar-mark {
    grid-column: 1 / span 3;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
  }
  .bar-role { grid-column: 4 / span 4; }
  .bar-back { color: var(--ink); }
  .bar-nav {
    grid-column: 8 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 24px;
  }
  .bar-nav a, .bar-lang, .bar-back { transition: color 0.18s; }
  .bar-nav a:hover, .bar-lang:hover, .bar-back:hover { color: var(--ink); }
  .bar-lang { font: inherit; letter-spacing: inherit; color: var(--muted); }
  .bar-lang b { font-weight: 400; color: var(--ink); }

  @media (max-width: 960px) {
    .bar-role, .bar-mail { display: none; }
    .bar-mark { grid-column: 1 / span 5; }
    .bar-nav { grid-column: 6 / -1; gap: 16px; }
  }
  @media (max-width: 480px) {
    .bar-mark .label { display: none; }
    .bar-mark { grid-column: 1 / span 2; }
    .bar-nav { grid-column: 3 / -1; }
  }
</style>
