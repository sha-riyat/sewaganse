---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, i, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, i, next } = Astro.props;
const n = i + 1;
const pad = (x: number) => String(x).padStart(2, '0');
---

<Base title={`${project.title.en} — Sewa Ganse`} description={project.description.en}>
  <article>
    <header class="head grid">
      <span class="label head-index">(2.{n}) — {pad(n)} / {pad(projects.length)}</span>
      <h1 class="head-title">
        <span class="lang-fr">{project.title.fr}</span>
        <span class="lang-en">{project.title.en}</span>
      </h1>
    </header>

    <!-- Spec sheet: what it is, for whom, where it lives. -->
    <section class="spec grid">
      <dl class="spec-list">
        <div>
          <dt class="label">Client</dt>
          <dd>
            <span class="lang-fr">{project.client.fr}</span>
            <span class="lang-en">{project.client.en}</span>
          </dd>
        </div>
        <div>
          <dt class="label">Services</dt>
          <dd>
            <span class="lang-fr">{project.services.fr}</span>
            <span class="lang-en">{project.services.en}</span>
          </dd>
        </div>
        {project.url && (
          <div>
            <dt class="label">
              <span class="lang-fr">Site web</span>
              <span class="lang-en">Website</span>
            </dt>
            <dd>
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="spec-link">
                {project.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗
              </a>
            </dd>
          </div>
        )}
      </dl>
      <p class="spec-desc">
        <span class="lang-fr">{project.description.fr}</span>
        <span class="lang-en">{project.description.en}</span>
      </p>
    </section>

    <section class="plates grid">
      {project.images.map((img, k) => (
        <figure class="plate">
          <img src={img} alt="" loading={k === 0 ? 'eager' : 'lazy'} />
          <figcaption class="label">(2.{n}.{k + 1})</figcaption>
        </figure>
      ))}
    </section>

    <a href={`/projects/${next.id}`} class="next grid">
      <span class="label next-label">
        <span class="lang-fr">Projet suivant</span>
        <span class="lang-en">Next project</span>
      </span>
      <span class="next-title">
        <span class="lang-fr">{next.title.fr}</span>
        <span class="lang-en">{next.title.en}</span>
        →
      </span>
    </a>
  </article>
</Base>

<style>
  .head { padding-top: 16px; padding-bottom: clamp(32px, 5vw, 72px); row-gap: clamp(40px, 8vw, 120px); }
  .head-index { grid-column: 1 / -1; }
  .head-title {
    grid-column: 1 / -1;
    font: 600 clamp(48px, 10vw, 180px)/0.86 var(--font);
    letter-spacing: -0.055em;
    margin-left: -0.04em;
    animation: arrive 1s var(--ease) both;
  }
  @keyframes arrive {
    from { opacity: 0; filter: blur(12px); transform: translateX(-4vw); }
  }

  .spec { padding-top: 16px; padding-bottom: clamp(48px, 7vw, 112px); border-top: 1px solid var(--line); }
  .spec-list { grid-column: 1 / span 5; display: grid; gap: 20px; }
  .spec-list dd { margin-top: 4px; font-size: 17px; }
  .spec-link { border-bottom: 1px solid var(--muted); transition: border-color 0.18s; }
  .spec-link:hover { border-color: var(--signal); }
  .spec-desc {
    grid-column: 7 / -1;
    font-size: clamp(20px, 1.9vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 34ch;
  }

  .plates { row-gap: var(--gap); padding-bottom: clamp(64px, 10vw, 160px); }
  .plate { grid-column: 1 / -1; display: grid; gap: 8px; }
  .plate img { width: 100%; background: var(--bg-2); }

  .next {
    align-items: end;
    padding-top: 16px;
    padding-bottom: clamp(48px, 8vw, 120px);
    border-top: 1px solid var(--line);
    row-gap: 24px;
  }
  .next-label { grid-column: 1 / -1; }
  .next-title {
    grid-column: 1 / -1;
    font: 500 clamp(36px, 6vw, 96px)/0.9 var(--font);
    letter-spacing: -0.05em;
    transition: color 0.2s, transform 0.4s var(--ease);
  }
  .next:hover .next-title { color: var(--muted); transform: translateX(12px); }

  @media (max-width: 960px) {
    .spec-list, .spec-desc { grid-column: 1 / -1; }
    .spec-desc { margin-top: 32px; }
  }
</style>
